{
    "extends": "tslint:recommended",
    "rulesDirectory": [""],
    "rules": {
        "max-line-length": {
            "options": [120]
        },
        "no-console": false,
        "no-trailing-whitespace": false,
        "whitespace": false,
        "align": false,
        "indent": false,
        "new-parens": true,
        "no-arg": true,
        "no-bitwise": true,
        "no-conditional-assignment": true,
        "no-consecutive-blank-lines": false,
        "max-classes-per-file":false,
        "curly": false
    },
    "jsRules": {
        "max-line-length": {
            "options": [120]
        }
    }
}